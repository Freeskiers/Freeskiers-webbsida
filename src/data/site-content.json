  "faq": [
    {
      "id": "faq-utrustning",
      "question": "Vilken utrustning behöver mitt barn ha med sig?",
      "answer": "Hjälm är ett absolut krav i både Helgskidskolan och Freeskiers skidklubb. I skidklubben krävs även ryggskydd medan det endast rekommenderas till skidskolan. Skidorna ska ha fungerande bindningar inställda efter barnets längd och vikt. Stavar behövs inte för nybörjare. Skidor, pjäxor, stavar och hjälmar kan hyras av Ekholmsnäsbackens skiduthyrning.",
      "category": "utrustning"
    },
    {
      "id": "faq-liftkort",
      "question": "Ingår liftkort i deltagaravgiften?",
      "answer": "Liftkort behövs inte i Helgskidskolan – vi har en egen liftkö. Skidklubbens träningsavgifter inkluderar liftkort, och vid privatlektion ingår ett tillfälligt liftkort under lektionen.",
      "category": "avgifter"
    },
    {
      "id": "faq-fritidskortet",
      "question": "Hur fungerar statliga Fritidskortet hos er?",
      "answer": "IK Lidingö Freeskiers är anslutna till Riksidrottsförbundet och godkänd förening för Fritidskortet. Du kan använda ditt barns fritidskortsaldo för att betala hela eller delar av deltagar- och medlemsavgiften.",
      "category": "avgifter"
    },
    {
      "id": "faq-forsakring",
      "question": "Är mitt barn försäkrat under träningarna?",
      "answer": "Ja! Alla deltagare med erlagd medlemsavgift är olycksfallsförsäkrade genom Svenska Skidförbundets gemensamma medlemsförsäkring hos Folksam under klubbens organiserade träningar och resor.",
      "category": "trygghet"
    },
    {
      "id": "faq-vader",
      "question": "Vad händer vid dåligt väder eller om det är för lite snö i Ekholmsnäsbacken?",
      "answer": "Om vädret är för dåligt eller om en lektion måste ställas in på grund av väder- eller snöläget så ställs den lektionen in och ersätts inte med ett nytt datum.",
      "category": "regler"
    },
    {
      "id": "faq-avbokning",
      "question": "Kan man få pengar tillbaka om barnet blir sjukt eller skadat?",
      "answer": "Enligt klubbens avboknings- och återbetalningsregler utgår ingen återbetalning vid skada, sjukdom eller missade tillfällen, då tränare och backtider bokas och bekostas i förväg för hela säsongen.",
      "category": "regler"
    },
    {
      "id": "faq-niva",
      "question": "Vilken grupp passar mitt barn?",
      "answer": "Gör skidtestet ”Hitta rätt nivå” här på sajten – tre frågor om ålder, kunskapsnivå och vad åkaren framför allt vill göra, och du får ett förslag. Helgskidskolan vänder sig till åkare från 5 år och Skidklubben till åk 1–9 som uppfyller minimikraven; för yngre nybörjare och vuxna passar en privatlektion.",
      "category": "grupper"
    },
    {
      "id": "faq-vuxna",
      "question": "Kan vuxna åka med er?",
      "answer": "Ja! Klubbens instruktörer erbjuder privatlektioner för barn, ungdomar och vuxna – en eller två personer i 60 minuter. Boka direkt på privatlektionssidan; liftkort ingår under lektionen.",
      "category": "grupper"
    }
  ],
